<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab_6.Pages.ImageViewerPage"
             BackgroundColor="#000000">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12,16,12,20">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Label x:Name="ViewerTitleLabel"
                   TextColor="#F8FAFC"
                   FontSize="16"
                   FontAttributes="Bold"
                   MaxLines="2"
                   LineBreakMode="TailTruncation"
                   VerticalOptions="Center" />

            <Button Grid.Column="1"
                    Text="✕"
                    Clicked="OnCloseClicked"
                    BackgroundColor="#1F2437"
                    TextColor="#F8FAFC"
                    FontSize="16"
                    FontAttributes="Bold"
                    WidthRequest="42"
                    HeightRequest="42"
                    CornerRadius="21"
                    Padding="0" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10">
            <Image x:Name="ZoomImage"
                   Aspect="AspectFit"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill">
                <Image.GestureRecognizers>
                    <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                    <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                    <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <Label Grid.Row="2"
               Text="Pinch or double-tap to zoom"
               TextColor="#94A3B8"
               FontSize="12"
               HorizontalTextAlignment="Center" />

    </Grid>
</ContentPage>
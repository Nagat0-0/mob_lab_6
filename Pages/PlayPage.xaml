<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="lab_6.Pages.PlayPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#0D0F17">

    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,24" Spacing="12">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Label Text="TIMECURATOR"
                       TextColor="#E2B75B"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center" />

                <Border Grid.Column="1"
                        BackgroundColor="#171A26"
                        Stroke="#262B3D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,6">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="SCORE" FontSize="9" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                        <Label x:Name="ScoreLabel" Text="0" FontSize="14" FontAttributes="Bold" TextColor="#F8FAFC" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2"
                        BackgroundColor="#171A26"
                        Stroke="#262B3D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,6">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="STREAK" FontSize="9" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                        <Label x:Name="StreakLabel" Text="0" FontSize="14" FontAttributes="Bold" TextColor="#34D399" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="3"
                        BackgroundColor="#171A26"
                        Stroke="#262B3D"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="10,6">
                    <VerticalStackLayout HorizontalOptions="Center">
                        <Label Text="BEST" FontSize="9" TextColor="#94A3B8" HorizontalTextAlignment="Center" />
                        <Label x:Name="BestLabel" Text="0" FontSize="14" FontAttributes="Bold" TextColor="#E2B75B" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button x:Name="EasyButton"
                        Text="Easy ±100y"
                        CommandParameter="Easy"
                        Clicked="OnDifficultyClicked"
                        CornerRadius="12"
                        HeightRequest="38"
                        Padding="0"
                        FontSize="12"
                        FontAttributes="Bold" />

                <Button x:Name="MediumButton"
                        Grid.Column="1"
                        Text="Medium ±50y"
                        CommandParameter="Medium"
                        Clicked="OnDifficultyClicked"
                        CornerRadius="12"
                        HeightRequest="38"
                        Padding="0"
                        FontSize="12"
                        FontAttributes="Bold" />

                <Button x:Name="HardButton"
                        Grid.Column="2"
                        Text="Hard ±25y"
                        CommandParameter="Hard"
                        Clicked="OnDifficultyClicked"
                        CornerRadius="12"
                        HeightRequest="38"
                        Padding="0"
                        FontSize="12"
                        FontAttributes="Bold" />
            </Grid>

            <Border BackgroundColor="#151824"
                    Stroke="#2A2F45"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    Padding="12">
                <VerticalStackLayout Spacing="10">
                    <Grid HeightRequest="285">
                        <Image x:Name="ArtworkImage"
                               Aspect="AspectFit"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnArtworkImageTapped" />
                            </Image.GestureRecognizers>
                        </Image>

                        <Border x:Name="ZoomBadge"
                                IsVisible="False"
                                BackgroundColor="#B30D0F17"
                                Stroke="#2A2F45"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                Padding="8,4"
                                HorizontalOptions="End"
                                VerticalOptions="End"
                                Margin="6"
                                InputTransparent="True">
                            <Label Text="⤢" TextColor="#E2B75B" FontSize="14" FontAttributes="Bold" />
                        </Border>

                        <ActivityIndicator x:Name="LoadingIndicator"
                                           IsRunning="True"
                                           IsVisible="True"
                                           Color="#E2B75B"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />

                        <VerticalStackLayout x:Name="ErrorPanel"
                                             IsVisible="False"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="10"
                                             Padding="12">
                            <Label x:Name="ErrorLabel"
                                   Text="Failed to load museum archive."
                                   TextColor="#F87171"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Retry"
                                    Clicked="OnRetryClicked"
                                    BackgroundColor="#E2B75B"
                                    TextColor="#0D0F17"
                                    FontAttributes="Bold"
                                    CornerRadius="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label x:Name="TitleLabel"
                           Text="Loading painting..."
                           TextColor="#F8FAFC"
                           FontSize="18"
                           FontAttributes="Bold"
                           MaxLines="2"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="GuessPanel"
                    BackgroundColor="#151824"
                    Stroke="#262B3D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="DifficultyInfoLabel"
                           Text="Limit: ±50 years • Miss resets score • Max 1500 pts"
                           TextColor="#94A3B8"
                           FontSize="12"
                           HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Label Text="1400" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                        <Label x:Name="SelectedYearLabel"
                               Grid.Column="1"
                               Text="1850"
                               TextColor="#E2B75B"
                               FontSize="32"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Grid.Column="2" Text="2020" TextColor="#64748B" FontSize="12" VerticalOptions="Center" />
                    </Grid>

                    <Slider x:Name="YearSlider"
                            Minimum="1400"
                            Maximum="2020"
                            Value="1850"
                            MinimumTrackColor="#E2B75B"
                            MaximumTrackColor="#2A2F45"
                            ThumbColor="#E2B75B"
                            ValueChanged="OnYearSliderChanged" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Button Text="-10" Clicked="OnAdjustYearClicked" CommandParameter="-10" BackgroundColor="#1F2437" TextColor="#CBD5E1" CornerRadius="10" HeightRequest="38" Padding="0" FontSize="13" />
                        <Button Grid.Column="1" Text="-1" Clicked="OnAdjustYearClicked" CommandParameter="-1" BackgroundColor="#1F2437" TextColor="#CBD5E1" CornerRadius="10" HeightRequest="38" Padding="0" FontSize="13" />
                        <Button Grid.Column="2" Text="+1" Clicked="OnAdjustYearClicked" CommandParameter="1" BackgroundColor="#1F2437" TextColor="#CBD5E1" CornerRadius="10" HeightRequest="38" Padding="0" FontSize="13" />
                        <Button Grid.Column="3" Text="+10" Clicked="OnAdjustYearClicked" CommandParameter="10" BackgroundColor="#1F2437" TextColor="#CBD5E1" CornerRadius="10" HeightRequest="38" Padding="0" FontSize="13" />
                    </Grid>

                    <Button x:Name="GuessButton"
                            Text="LOCK IN GUESS"
                            Clicked="OnGuessClicked"
                            BackgroundColor="#E2B75B"
                            TextColor="#0D0F17"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="50"
                            CornerRadius="14" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="ResultPanel"
                    IsVisible="False"
                    BackgroundColor="#151824"
                    Stroke="#2A2F45"
                    StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="ResultVerdictLabel"
                                   Text="STREAK KEPT!"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#34D399" />
                            <Label x:Name="ResultDiffLabel"
                                   Text=""
                                   FontSize="13"
                                   TextColor="#F8FAFC" />
                        </VerticalStackLayout>

                        <Border x:Name="ResultPointsBorder"
                                Grid.Column="1"
                                BackgroundColor="#1D2B24"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,6"
                                VerticalOptions="Center">
                            <Label x:Name="ResultPointsLabel"
                                   Text="+900 pts"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#34D399" />
                        </Border>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#262B3D" />

                    <Label x:Name="RevealArtistLabel"
                           Text=""
                           TextColor="#E2E8F0"
                           FontSize="14"
                           FontAttributes="Bold" />

                    <Label x:Name="RevealMetaLabel"
                           Text=""
                           TextColor="#CBD5E1"
                           FontSize="13" />

                    <Label x:Name="RevealMediumLabel"
                           Text=""
                           TextColor="#94A3B8"
                           FontSize="12" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button x:Name="SaveButton"
                                Text="Save to Gallery"
                                Clicked="OnSaveClicked"
                                BackgroundColor="#1F2437"
                                TextColor="#E2B75B"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="48" />

                        <Button Grid.Column="1"
                                Text="Next Painting →"
                                Clicked="OnNextClicked"
                                BackgroundColor="#E2B75B"
                                TextColor="#0D0F17"
                                FontAttributes="Bold"
                                CornerRadius="14"
                                HeightRequest="48" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
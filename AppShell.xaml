<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="lab_6.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:lab_6.Pages"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="#12141E"
    Shell.ForegroundColor="#E2B75B"
    Shell.TitleColor="#F8FAFC"
    Shell.TabBarBackgroundColor="#12141E"
    Shell.TabBarForegroundColor="#E2B75B"
    Shell.TabBarTitleColor="#E2B75B"
    Shell.TabBarUnselectedColor="#64748B">

    <TabBar>
        <Tab Title="Play" Icon="tab_play.png">
            <ShellContent ContentTemplate="{DataTemplate pages:PlayPage}" Route="play" />
        </Tab>
        <Tab Title="Gallery" Icon="tab_gallery.png">
            <ShellContent ContentTemplate="{DataTemplate pages:GalleryPage}" Route="gallery" />
        </Tab>
    </TabBar>

</Shell>